# Cloudflare Workers AI (free allowance: 10,000 Neurons per day)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# klein-4b | klein-9b | dev
IMAGE_MODEL=klein-4b

# Claude (optional, writes prompts; needs a paid API key)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium

# Chat editing agent (LangGraph): auto | claude | cloudflare | off
# auto uses Claude when ANTHROPIC_API_KEY is set, else the free Cloudflare model below.
AGENT_BRAIN=auto
AGENT_LLM_MODEL=@cf/meta/llama-4-scout-17b-16e-instruct
AGENT_MAX_STEPS=4
# 1 = a vision model checks each round and retries a missed edit once
AGENT_REVIEW=1
